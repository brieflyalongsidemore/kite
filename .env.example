# Kite reads these on startup. Everything can also be set in the app under Settings,
# which saves to data/settings.json and takes precedence over this file.

# --- Writer: the LLM that researches, plans and writes -------------------------------
# anthropic | bedrock | openai | openrouter | compatible  (auto-detected if unset)
KITE_WRITER_PROVIDER=
KITE_WRITER_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Amazon Bedrock uses your normal AWS credentials (env vars, ~/.aws, SSO)
AWS_REGION=
AWS_PROFILE=
# For "compatible": any OpenAI-compatible server, e.g. Ollama or LM Studio
KITE_WRITER_BASE_URL=

# --- Judge: Jev, TypeSafe's decision model --------------------------------------------
# openrouter | typesafe
KITE_JUDGE_PROVIDER=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# --- Optional ----------------------------------------------------------------------------
# General web search during research (Brave Search API has a free tier)
BRAVE_API_KEY=
# Read X profiles directly (X API reads are paid; pasting your profile works without it)
X_BEARER_TOKEN=
# Where Kite keeps your data (default: ./data)
KITE_DATA=
